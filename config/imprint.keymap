#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// ── Key position groups for positional home row mods ─────────────
// Left-hand keys: rows 0-4 left side
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52
// Right-hand keys: rows 0-4 right side
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55 56 57
// All thumb keys
#define THUMBS 58 59 60 61 62 63 64 65 66 67 68 69

/ {
    chosen { zmk,matrix-transform = &imprint_number_row_full_bottom_row; };

    behaviors {
        // Home row mod — left hand
        // Hold triggers only when a RIGHT-hand key or thumb is pressed
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // Home row mod — right hand (mirror)
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";
        // Press Z + / together to toggle gaming layer
        combo_gaming {
            timeout-ms = <50>;
            key-positions = <37 46>; // Z (row3 col1) + / (row3 col10)
            bindings = <&tog 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ┌─────────────────────────────────────────────────────────┐
        // │ Layer 0: Default                                        │
        // │                                                         │
        // │ Home row mods: hold = modifier, tap = letter            │
        // │ Thumb: RET NAV DEL(hard) | ·(semi) BSPC SPACE          │
        // │        SYM SHFT ·(semi)  | MO3(hard) SHFT ESC          │
        // └─────────────────────────────────────────────────────────┘
        default_layer {
            bindings = <
&kp ESC     &kp N1         &kp N2        &kp N3          &kp N4          &kp N5                &kp N6   &kp N7          &kp N8          &kp N9         &kp N0           &kp EQUAL
&kp GRAVE   &kp Q          &kp W         &kp E           &kp R           &kp T                 &kp Y    &kp U           &kp I           &kp O          &kp P            &kp BSLH
&kp TAB     &hml LGUI A    &hml LALT S   &hml LCTRL D    &hml LSHFT F    &kp G                 &kp H    &hmr RSHFT J    &hmr RCTRL K    &hmr RALT L    &hmr RGUI SEMI   &kp SQT
&mo 4       &kp Z          &kp X         &kp C           &kp V           &kp B                 &kp N    &kp M           &kp COMMA       &kp DOT        &kp FSLH         &kp MINUS
&none       &none          &none         &none           &none                                           &none           &none           &none          &none            &none
                                                          &kp RET         &mo 1      &kp DEL    &none    &kp BSPC        &kp SPACE
                                                          &mo 2           &kp LSHFT  &none      &mo 3    &kp RSHFT       &kp ESC
            >;
        };

        // ┌─────────────────────────────────────────────────────────┐
        // │ Layer 1: Nav                                            │
        // │                                                         │
        // │ Left:  mods on home row (for Ctrl+Arrow combos)         │
        // │        partial numpad on rows 1, 3, 4                   │
        // │ Right: arrows, home/end, pgup/pgdn                     │
        // └─────────────────────────────────────────────────────────┘
        nav_layer {
            bindings = <
&kp F1      &kp F2         &kp F3        &kp F4          &kp F5          &kp F6                &kp F7   &kp F8          &kp F9          &kp F10        &kp F11          &kp F12
&trans      &trans         &kp N7        &kp N8          &kp N9          &trans                &trans   &kp HOME        &kp PG_UP       &kp PG_DN      &kp END          &trans
&trans      &kp LGUI       &kp LALT      &kp LCTRL       &kp LSHFT       &trans                &trans   &kp LEFT        &kp UP          &kp DOWN       &kp RIGHT        &trans
&trans      &trans         &kp N1        &kp N2          &kp N3          &trans                &trans   &trans          &trans          &trans         &trans           &trans
&trans      &trans         &trans        &kp N0          &trans                                          &trans          &trans          &trans         &trans           &trans
                                                          &trans          &trans     &trans     &trans   &kp BSPC        &kp SPACE
                                                          &trans          &kp LSHFT  &trans     &trans   &kp RSHFT       &kp ESC
            >;
        };

        // ┌─────────────────────────────────────────────────────────┐
        // │ Layer 2: Symbols                                        │
        // │                                                         │
        // │ Number row: shifted symbols in same positions (familiar)│
        // │ Home row: opening brackets left, closing brackets right │
        // │ Bottom row: backslash, underscore, minus / plus, equal  │
        // └─────────────────────────────────────────────────────────┘
        sym_layer {
            bindings = <
&kp PLUS    &kp EXCL       &kp AT        &kp HASH        &kp DLLR        &kp PRCNT             &kp CARET &kp AMPS       &kp ASTRK       &kp LPAR       &kp RPAR         &kp UNDER
&kp TILDE   &trans         &trans        &trans          &trans          &trans                &trans   &trans          &trans          &trans         &trans           &kp PIPE
&trans      &kp LBRC       &kp LBKT      &kp LPAR        &kp LT          &trans                &trans   &kp GT          &kp RPAR        &kp RBKT       &kp RBRC         &kp PIPE
&trans      &trans         &kp BSLH      &kp UNDER       &kp MINUS       &trans                &trans   &kp PLUS        &kp EQUAL       &trans         &trans           &trans
&trans      &trans         &trans        &trans          &trans                                          &trans          &trans          &trans         &trans           &trans
                                                          &trans          &trans     &trans     &trans   &kp BSPC        &kp SPACE
                                                          &trans          &kp LSHFT  &trans     &trans   &kp RSHFT       &kp ESC
            >;
        };

        // ┌─────────────────────────────────────────────────────────┐
        // │ Layer 3: Auto Mouse (trackball auto-activate)           │
        // │                                                         │
        // │ S = right click, D = middle click, F = left click       │
        // │ All other keys transparent to active layer              │
        // └─────────────────────────────────────────────────────────┘
        auto_mouse_layer {
            bindings = <
&trans   &trans   &trans      &trans      &trans      &trans              &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans      &trans      &trans      &trans              &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &mkp RCLK   &mkp MCLK   &mkp LCLK   &trans              &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans      &trans      &trans      &trans              &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans      &trans      &trans                                   &trans   &trans   &trans   &trans   &trans
                                           &trans      &trans   &trans    &trans   &trans   &trans
                                           &trans      &trans   &trans    &trans   &trans   &trans
            >;
        };

        // ┌─────────────────────────────────────────────────────────┐
        // │ Layer 4: Keyboard Control (hold MO4 / bottom-left key)  │
        // │                                                         │
        // │ BT, RGB, reset, bootloader                              │
        // │ Gaming toggle: press Z + / combo                        │
        // └─────────────────────────────────────────────────────────┘
        keyboard_control_layer {
            bindings = <
&bt BT_CLR    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4          &trans            &rgb_ug RGB_TOG   &rgb_ug RGB_EFF   &trans            &trans            &trans
&sys_reset    &trans          &trans          &trans          &trans          &trans                &rgb_ug RGB_TOG   &rgb_ug RGB_HUI   &rgb_ug RGB_SAI   &rgb_ug RGB_BRI   &rgb_ug RGB_SPI   &sys_reset
&bootloader   &trans          &trans          &trans          &trans          &trans                &trans            &rgb_ug RGB_HUD   &rgb_ug RGB_SAD   &rgb_ug RGB_BRD   &rgb_ug RGB_SPD   &bootloader
&trans        &trans          &trans          &trans          &trans          &trans                &trans            &trans            &trans            &trans            &trans            &trans
&trans        &trans          &trans          &trans          &trans                                                  &trans            &trans            &trans            &trans            &trans
                                                              &trans          &trans     &trans     &trans            &trans            &trans
                                                              &trans          &trans     &trans     &trans            &trans            &trans
            >;
        };

        // ┌─────────────────────────────────────────────────────────┐
        // │ Layer 5: Gaming                                         │
        // │                                                         │
        // │ Whole layout shifts 1 column right for ESDF home.       │
        // │ Physical ESDF sends WASD — no per-game rebinding.       │
        // │ No home row mods. Plain keys for held movement.         │
        // │ Toggle in/out: press Z + / combo                        │
        // └─────────────────────────────────────────────────────────┘
        gaming_layer {
            bindings = <
&kp ESC     &kp N1          &kp N2         &kp N3          &kp N4          &kp N5                &kp N6    &kp N7          &kp N8          &kp N9         &kp N0           &kp MINUS
&none       &kp TAB         &kp Q          &kp W           &kp E           &kp R                 &kp Y     &kp U           &kp I           &kp O          &kp P            &kp BSLH
&none       &none           &kp A          &kp S           &kp D           &kp F                 &kp H     &kp J           &kp K           &kp L          &kp SEMI         &kp SQT
&none       &kp LSHFT       &kp Z          &kp X           &kp C           &kp V                 &kp N     &kp M           &kp COMMA       &kp DOT        &kp FSLH         &none
&none       &none           &none          &none           &none                                            &none           &none           &none          &none            &none
                                                            &kp LCTRL       &kp SPACE  &none      &none     &kp BSPC        &kp SPACE
                                                            &kp LALT        &kp LSHFT  &none      &none     &kp RET         &kp ESC
            >;
        };
    };
};

// ── Trackball configuration ──────────────────────────────────────

// Right hand trackball: cursor movement, auto-activates mouse layer
&trackball_peripheral_listener {
    input-processors =
        <&zip_temp_layer 3 500>;
};

// Left hand trackball: scroll wheel
&trackball_central_listener {
    input-processors =
        <&zip_xy_scaler 1 3>,
        <&zip_xy_to_scroll_mapper>,
        <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>;
};
